{
  "name": "davmedia-app",
  "version": "26.10.1",
  "private": true,
  "type": "module",
  "description": "_davMEDIA — local audio and video toolbox for Windows, macOS and Linux by _davstudios.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.mjs",
    "tauri": "tauri",
    "desktop": "npm run prepare:ffmpeg && tauri dev",
    "bundle": "npm run prepare:ffmpeg && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-opener": "2"
  },
  "devDependencies": {
    "@derhuerst/ffprobe-static": "5.3.0",
    "@tauri-apps/cli": "2.11.4",
    "ffmpeg-static": "5.3.0",
    "vite": "8.2.2"
  },
  "allowScripts": {
    "ffmpeg-static": true,
    "@derhuerst/ffprobe-static": true
  },
  "author": "_davstudios",
  "license": "MIT",
  "homepage": "https://davstudios.it"
}
